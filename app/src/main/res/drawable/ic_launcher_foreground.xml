<?xml version="1.0" encoding="utf-8"?>
<!-- CHANGE-MARKER: Marken-Icon "D4" auf Warm-Palette (P2.5, siehe CHANGELOG.md).
     Ring/Funke = Terracotta-Akzent (#A5735C), schwebender Punkt = Creme (#F6ECE3),
     Halo hinter dem Punkt = dunkles Braun (#3A2F2A). Hintergrund (Creme #EDD9CA) via
     @color/ic_launcher_background im adaptive-icon. Motiv in der 108er-Safe-Zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring "O": Außenkreis r=28 minus Innenkreis r=16 (evenOdd) um (54,54). -->
    <path
        android:fillColor="#A5735C"
        android:fillType="evenOdd"
        android:pathData="M54,26 a28,28 0 1,0 0.01,0 Z M54,38 a16,16 0 1,1 -0.01,0 Z" />

    <!-- Dunkler Halo hinter dem schwebenden Punkt (Kontrast → Punkt liegt "davor"). -->
    <path
        android:fillColor="#3A2F2A"
        android:pathData="M74,34 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />

    <!-- Schwebender Punkt (Creme/Paper). -->
    <path
        android:fillColor="#F6ECE3"
        android:pathData="M74,34 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z" />

    <!-- KI-Funke im Punkt (Terracotta). -->
    <path
        android:fillColor="#A5735C"
        android:pathData="M74,34 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
</vector>

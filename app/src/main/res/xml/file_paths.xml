<!-- FileProvider-Pfade für den APK-Download des In-App-Updaters.
     Das heruntergeladene APK liegt in cache/updates/ und wird per content://-URI
     an den PackageInstaller/System-Installer übergeben. -->
<paths>
    <cache-path name="updates" path="updates/" />
    <files-path name="shared" path="shared/" />
</paths>

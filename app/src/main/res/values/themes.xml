<?xml version="1.0" encoding="utf-8"?>
<!-- CHANGE-MARKER v0.1.0: Initiales Projektgrundgerüst (siehe CHANGELOG.md) -->
<!-- Basis-Theme. Das eigentliche Farb-/Typo-System kommt aus Compose (core-ui),
     dieses XML-Theme setzt nur die Fenster-Grundlage vor dem ersten Compose-Frame. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OverlAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Transparentes Theme für die kurzlebigen Entry-Activities (PROCESS_TEXT/SEND),
         die als Bottom-Sheet/Overlay über der Host-App erscheinen. -->
    <style name="Theme.OverlAI.Transparent" parent="Theme.OverlAI">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
